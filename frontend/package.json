{
  "name": "carcinova",
  "private": true,
  "version": "1.0.0",
  "main": "electron.js",
  "author": "Carcinova",
  "description": "Carcinova AI - Cancer Detection System",
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron .",
    "start": "concurrently \"npm run dev\" \"electron .\"",
    "dist": "npm run build && npx electron-builder --win portable"
  },
  "build": {
    "appId": "com.carcinova.app",
    "productName": "Carcinova",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../Carcinova.ico",
        "to": "Carcinova.ico"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "../Carcinova.ico"
    }
  },
  "dependencies": {
    "axios": "^1.16.0",
    "konva": "^10.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-konva": "^19.2.4",
    "react-router-dom": "^7.15.0",
    "use-image": "^1.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.12"
  }
}
